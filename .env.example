# Copy to .env and fill in. .env is gitignored.

# Named AWS CLI profile (~/.aws/credentials) to use for every script in
# scripts/ — never rely on whatever the ambient default profile happens to
# be, especially if this machine has more than one AWS account configured.
AWS_PROFILE=lavanya
AWS_REGION=us-east-1

# S3 buckets (globally-unique suffix required)
TRADELENS_RAW_BUCKET=tradelens-raw-<your-suffix>
TRADELENS_CURATED_BUCKET=tradelens-curated-<your-suffix>
TRADELENS_CODE_BUCKET=tradelens-code-<your-suffix>

# AWS Budgets alarm (see infra/README.md SS0) — set up before creating anything else.
TRADELENS_BUDGET_NAME=tradelens-monthly
TRADELENS_BUDGET_LIMIT_USD=5
TRADELENS_BILLING_ALERT_EMAIL=

# EMR Serverless
TRADELENS_EMR_APP_NAME=tradelens
TRADELENS_EMR_RELEASE_LABEL=emr-7.2.0
TRADELENS_EMR_JOB_ROLE_NAME=tradelens-emr-job-role
# Filled in automatically by scripts/setup_aws.sh — leave blank initially.
TRADELENS_EMR_APP_ID=
TRADELENS_EMR_JOB_ROLE_ARN=

# Glue / Athena
TRADELENS_GLUE_DB=tradelens_db
TRADELENS_ATHENA_WORKGROUP=tradelens-athena-wg
TRADELENS_ATHENA_OUTPUT=s3://tradelens-curated-<your-suffix>/athena-results/

# Redshift Serverless
TRADELENS_REDSHIFT_NAMESPACE=tradelens-redshift-ns
TRADELENS_REDSHIFT_WORKGROUP=tradelens-redshift-wg
TRADELENS_REDSHIFT_DB=tradelens

# Set to 'local' for filesystem, 'aws' for s3a paths
TRADELENS_ENV=local
